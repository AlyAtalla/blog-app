<h1 class="text-3xl font-bold mb-6">All Posts</h1>

<% @posts.each do |post| %>
  <div class="bg-white p-6 rounded-lg shadow mb-6">
    <h2 class="text-2xl font-semibold mb-2">
      <%= link_to post.title, post_path(post), class: "text-blue-600 hover:underline" %>
    </h2>
    <p class="text-gray-700 mb-2"><%= truncate(post.body, length: 150) %></p>
    <p class="text-sm text-gray-500">By <%= post.user.email %> • <%= time_ago_in_words(post.created_at) %> ago</p>
  </div>
<% end %>

<div class="bg-white p-6 rounded-lg shadow">
  <h1 class="text-3xl font-bold mb-4"><%= @post.title %></h1>
  <p class="mb-4 text-gray-800"><%= @post.body %></p>
  <p class="text-sm text-gray-500 mb-6">By <%= @post.user.email %>, <%= @post.created_at.strftime("%B %d, %Y") %></p>

  <% if @post.user == current_user %>
    <div class="mb-6">
      <%= link_to "Edit", edit_post_path(@post), class: "bg-yellow-400 px-4 py-2 rounded hover:bg-yellow-500 mr-3" %>
      <%= link_to "Delete", @post, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600" %>
    </div>
  <% end %>

  <!-- Comments -->
  <h2 class="text-2xl font-bold mb-4">Comments</h2>
  <%= render @post.comments %>

  <h3 class="text-xl font-semibold mt-6 mb-2">Add a Comment</h3>
  <%= render "comments/form", post: @post, comment: @comment %>
</div>

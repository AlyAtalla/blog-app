<%= form_with model: [post, comment], local: true, class: "space-y-3" do |f| %>
  <div>
    <%= f.text_area :body, rows: 3, placeholder: "Write your comment...", class: "w-full border rounded px-3 py-2" %>
  </div>
  <%= f.submit "Post Comment", class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
<% end %>
